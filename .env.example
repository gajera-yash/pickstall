# Copy to .env.local and fill in the values there. Never commit .env.local.
# Names only in this file. Never put real values here.

# App
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_ROOT_DOMAIN=

# MongoDB (dev database, no real data). Server only.
MONGODB_URI=
# Optional, defaults to "pickstall"
MONGODB_DB=

# Better Auth: long random string that signs session cookies. Server only.
BETTER_AUTH_SECRET=

# Google sign-in (optional). Server only. Redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Show "Continue with Google". Set to true only when the two values above are set.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=

# Server-only secret for hashing IP addresses in rate limits (any long random string)
IP_HASH_SECRET=

# Where uploaded images are saved (optional; default .data/uploads). Use a persistent volume in production.
UPLOAD_DIR=

# Stripe (Block D, test mode only). Server only unless NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_PLATFORM_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Mux (Phase 2). Server only.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=

# Email: sign-in codes now, receipts in Block E. Server only.
# Empty in development = the code is printed in the dev server log.
RESEND_API_KEY=re_2N5MpLk6_JHJDVSdmXzHq1YvXaZ2ugDAX
# Sender, for example: Pickstall <login@yourdomain.com> (needs a domain verified in Resend)
EMAIL_FROM=

# Jobs (later). Server only.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Observability (Block F)
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=
