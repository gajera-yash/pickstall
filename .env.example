# Copy to .env.local and fill in the values there. Never commit .env.local.
# Names only in this file. Never put real values here.

# App
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_ROOT_DOMAIN=

# Supabase (hosted DEV project only, see docs/DECISIONS.md D-001)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or legacy service_role key. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Database test safety guard (tests/db/guard.ts)
# The dev project's ref (the part before .supabase.co in the project URL)
SUPABASE_DEV_PROJECT_REF=
# Must be exactly: dev-only
DB_TESTS_ALLOW=

# Stripe (Block D, test mode only). Server only unless NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_PLATFORM_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Mux (Phase 2). Server only.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=

# Email (Block E). Server only.
RESEND_API_KEY=

# Jobs (later). Server only.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Observability (Block F)
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=
