# Copy to .env.local and fill in the values there. Never commit .env.local.
# Names only in this file. Never put real values here.

# App
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_ROOT_DOMAIN=

# MongoDB (dev database, no real data). Server only.
MONGODB_URI=
# Optional, defaults to "pickstall"
MONGODB_DB=

# Better Auth: long random string that signs session cookies. Server only.
BETTER_AUTH_SECRET=

# Google sign-in (optional). Server only. Redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Show "Continue with Google". Set to true only when the two values above are set.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=

# Server-only secret for hashing IP addresses in rate limits (any long random string)
IP_HASH_SECRET=

# Development only: extra hosts the dev server may be opened from, comma separated (for example a tunnel
# like abc.ngrok-free.app). Localhost, 127.0.0.1, LAN IPs and this PC's name already work (D-041).
DEV_ALLOWED_HOSTS=

# Where uploaded images are saved (optional; default .data/uploads). Use a persistent volume in production.
UPLOAD_DIR=
PRODUCT_FILES_DIR=

# Stripe (Block D, test mode only). Server only unless NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_PLATFORM_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
# Test mode only (D-034): your own Stripe account id (acct_...), usable as a store's seller account.
STRIPE_PLATFORM_ACCOUNT_ID=

# Bunny Stream: course lesson videos (D-055, D-058). Server only. From your Stream library in the Bunny dashboard.
# Library id + API key (API page): turn on upload; video status is checked with Bunny while you wait.
# Token authentication key (Security page): signs playback links. Required in production; in
#   development, without it, videos play unsigned (keep token authentication off in Bunny then).
# Read-only API key (API page): verifies Bunny's webhook, which only works once the site is online.
# Without the library id and API key, upload is off and YouTube/Vimeo links still work.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_READONLY_KEY=

# Email: sign-in codes now, receipts in Block E. Server only.
# Empty in development = the code is printed in the dev server log.
RESEND_API_KEY=
# Sender, for example: Pickstall <login@yourdomain.com> (needs a domain verified in Resend)
EMAIL_FROM=

# Inngest background jobs: coaching call reminders (D-085). Server only.
# Development: run the Inngest dev server and set INNGEST_DEV=1 instead of the keys.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=

# Observability (Block F)
NEXT_PUBLIC_POSTHOG_KEY=
# Sentry error monitoring (D-075). Leave empty to turn it off. The DSN is not a secret, but use the
# same project for both. The last three only upload source maps at build time (Vercel or CI).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=                   # build only, secret
