# Copy to .env.local and fill in the values there. Never commit .env.local.
# Names only in this file. Never put real values here.

# App
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_ROOT_DOMAIN=

# MongoDB (dev database, no real data). Server only.
MONGODB_URI=
# Optional, defaults to "pickstall"
MONGODB_DB=

# Better Auth: long random string that signs session cookies. Server only.
BETTER_AUTH_SECRET=

# Google sign-in (optional). Server only. Redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Show "Continue with Google". Set to true only when the two values above are set.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=

# Server-only secret for hashing IP addresses in rate limits (any long random string)
IP_HASH_SECRET=

# Development only: extra hosts the dev server may be opened from, comma separated (for example a tunnel
# like abc.ngrok-free.app). Localhost, 127.0.0.1, LAN IPs and this PC's name already work (D-041).
DEV_ALLOWED_HOSTS=

# Where uploaded images are saved (optional; default .data/uploads). Use a persistent volume in production.
UPLOAD_DIR=
PRODUCT_FILES_DIR=
# Cloudflare R2 (D-093): private bucket for product and lesson files. Server only.
# Account id: Cloudflare dashboard > R2. Keys: R2 > Manage API tokens > "Object Read & Write" for this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Payments provider (D-118): PayPal by default. Set to "stripe" only to turn the dormant Stripe code back on.
PAYMENT_PROVIDER=
# PayPal (sandbox until live is approved). Server only. Two money flows:
#  1. Creators pay for a Pickstall plan -> YOUR PayPal REST app (Subscriptions).
#  2. Buyers pay for a creator's product -> the CREATOR's own PayPal REST app (they paste its keys in Settings > Payments).
PAYPAL_MODE=sandbox
# Your own PayPal REST app (developer.paypal.com > Apps & Credentials): platform billing only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook on YOUR app -> https://<domain>/api/webhooks/paypal (BILLING.SUBSCRIPTION.*, PAYMENT.SALE.COMPLETED): its id.
PAYPAL_WEBHOOK_ID=
# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"):
# encrypts creators' PayPal secrets. Never change it once creators connected, or they must connect again.
PAYMENT_CREDENTIALS_KEY=

# Stripe (dormant since D-118; test mode until live is approved). Server only. Two money flows (D-092):
#  1. Creators pay for a Pickstall plan -> YOUR Stripe account (Billing).
#  2. Buyers pay for a creator's product -> the CREATOR's own Stripe account (Connect, direct charge).
STRIPE_SECRET_KEY=
# Webhook "Your account" -> https://<domain>/api/webhooks/stripe (plans; test-mode sales on your account).
STRIPE_PLATFORM_WEBHOOK_SECRET=
# Webhook "Connected accounts" -> https://<domain>/api/webhooks/stripe-connect (creators' sales and refunds).
STRIPE_CONNECT_WEBHOOK_SECRET=
# Connect > Onboarding options > OAuth: the client id (ca_...); redirect https://<domain>/api/connect/stripe/callback.
STRIPE_CONNECT_CLIENT_ID=
# Test mode only (D-034): your own Stripe account id (acct_...), usable as a store's seller account.
STRIPE_PLATFORM_ACCOUNT_ID=

# Bunny Stream: course lesson videos (D-055, D-058). Server only. From your Stream library in the Bunny dashboard.
# Library id + API key (API page): turn on upload; video status is checked with Bunny while you wait.
# Token authentication key (Security page): signs playback links. Required in production; in
#   development, without it, videos play unsigned (keep token authentication off in Bunny then).
# Read-only API key (API page): verifies Bunny's webhook, which only works once the site is online.
# Without the library id and API key, upload is off and YouTube/Vimeo links still work.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_READONLY_KEY=

# Email: sign-in codes now, receipts in Block E. Server only.
# Empty in development = the code is printed in the dev server log.
RESEND_API_KEY=
# Resend > Webhooks: endpoint https://www.pickstall.store/api/webhooks/resend, events email.bounced and email.complained (D-095).
RESEND_WEBHOOK_SECRET=
# Sender, for example: Pickstall <login@yourdomain.com> (needs a domain verified in Resend)
# Platform admin sign-in at /admin/login (D-109). Server only. Password: at least 12 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
EMAIL_FROM=

# Outreach DM drafts in Admin > Growth (D-121). Server only.
# template (default, no AI) or groq. Turn on Zero Data Retention in Groq > Settings > Data Controls.
MARKETING_AI_PROVIDER=
GROQ_API_KEY=
# Default openai/gpt-oss-120b
GROQ_MODEL=
# Daily growth report at 21:00 IST (D-122): your own email. Empty = saved in Admin > Growth > Reports only.
GROWTH_REPORT_EMAIL=

# Inngest background jobs: coaching call reminders (D-085). Server only.
# Development: run the Inngest dev server and set INNGEST_DEV=1 instead of the keys.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=

# Observability (Block F)
NEXT_PUBLIC_POSTHOG_KEY=
# Sentry error monitoring (D-075). Leave empty to turn it off. The DSN is not a secret, but use the
# same project for both. The last three only upload source maps at build time (Vercel or CI).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=                   # build only, secret

# Browser push notifications (D-132). Make the pair with `pnpm push:keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
